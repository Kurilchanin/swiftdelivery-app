# Copy to .env and adjust.
VITE_TON_NETWORK=testnet
VITE_TONCONNECT_MANIFEST_URL=
# Marketplace address per network. The app picks one based on VITE_TON_NETWORK.
VITE_MARKETPLACE_ADDRESS=
VITE_MARKETPLACE_ADDRESS_MAINNET=
# Testnet only: the test USDT master the testnet Marketplace was deployed with
# (contract/scripts/deploy-test-usdt.tolk). Mainnet always uses Tether's USD₮.
VITE_USDT_MASTER_TESTNET=
# Optional but recommended: a toncenter API key (https://toncenter.com).
# Without it the public RPC throttles hard (HTTP 500/429).
VITE_TONCENTER_API_KEY=
VITE_TONCENTER_API_KEY_MAINNET=
# Base t.me link of the mini app, used to build referral links
# (defaults to https://t.me/SwiftDelivery_bot/app when empty).
VITE_MINIAPP_URL=
